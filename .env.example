# Hyperliquid API credentials (single-user .env fallback; production users
# register via Telegram and credentials are encrypted in the DB).
HL_ACCOUNT_ADDRESS=0x_your_master_account_address
HL_API_WALLET=0x_your_api_wallet_address
HL_API_SECRET=0x_your_api_wallet_private_key

# Discord adapter — only used when input.adapter is 'discord' (currently
# bypassed in favor of the Telegram-channel adapter; see below).
DISCORD_BOT_TOKEN=your_discord_bot_token

# Telegram bot (the bot users interact with for /menu, /config, etc.)
TELEGRAM_BOT_TOKEN=your_bot_token_from_botfather
TELEGRAM_ADMIN_IDS=123456789,987654321

# Admin REST API on :8081 — single shared key, X-API-Key header
ADMIN_API_KEY=your_long_random_key

# Encryption master key for stored credentials. Leave unset to auto-generate
# at data/.encryption_key (single-server use only).
# ENCRYPTION_KEY=

# --- Telethon forwarder (Phase 4.1) ---
# scripts/telethon_forwarder.py runs as a user-account client. It subscribes
# to @PotionScannerBot DMs and re-posts each into a private channel where
# the trading bot is admin. See the docstring in scripts/telethon_forwarder.py
# for the full setup walkthrough.
#
# API credentials: create at https://my.telegram.org/auth (free, one-time)
TG_API_ID=12345678
TG_API_HASH=0123456789abcdef0123456789abcdef
# Personal phone number (with country code) for the Telegram user account
TG_PHONE=+15551234567
# The source bot to subscribe to. Default is the prod scanner; override
# for staging if needed.
TG_SOURCE_BOT=@PotionScannerBot
# Destination channel ID — the private channel the trading bot listens to
# via the telegram_channel adapter. Numeric (format -100xxxxxxxxxx).
TG_DEST_CHANNEL_ID=-1001234567890
# Session file path. CONTAINS account-level credentials; chmod 600
# enforced at startup, .gitignore'd by default.
TG_SESSION_FILE=data/.telethon_session
